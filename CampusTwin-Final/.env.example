# CampusTwin settings reference. Copy each block into the file named above it. Never commit real values.

# ---- server/.env ----
PORT=5000
MONGO_URI=
JWT_SECRET=
CLIENT_URL=http://localhost:5173
ADMIN_NAME=Campus Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_PASSWORD=

# ---- client/.env ----
VITE_API_URL=http://localhost:5000/api
# Leave empty to use the API address without /api
VITE_SOCKET_URL=
